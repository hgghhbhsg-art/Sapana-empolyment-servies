rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Vacancies: Overseas job demand orders
    match /vacancies/{vacancyId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Applicants: Registrations and job submissions
    match /applicants/{applicantId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Live Chat Messages: Applicant and office staff communications
    match /chat_messages/{messageId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }

    // Default deny for all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
